# Copy to .env for local use only — do NOT commit real values.
# Set the same keys in your host's environment variables (e.g. EdgeOne project settings).

# BotFather HTTP API token (required)
BOT_TOKEN=123456:ABC-DEF_your_bot_token_here

# Recommended: random string; must match setWebhook secret_token
WEBHOOK_SECRET=change-me-to-a-long-random-string

# --- Optional: private / allowlist mode ---
# Default is off (anyone can use the bot). Set to true to only reply to privileged users.
# PRIVILEGED_ONLY=true

# Seed allowlist (comma-separated Telegram numeric user ids). Enough for private mode
# without binding KV. Discover your id with /whoami while PRIVILEGED_ONLY is off.
# BOOTSTRAP_PRIVILEGED_IDS=123456789

# Optional: bind EdgeOne KV as PRIV_KV if you want /grant and /revoke without redeploying.
