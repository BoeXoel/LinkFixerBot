# Copy to .env for local use only — do NOT commit real values.
# In EdgeOne console, set the same keys under Project → Environment Variables.

# BotFather HTTP API token (required)
BOT_TOKEN=123456:ABC-DEF_your_bot_token_here

# Optional but recommended: random string; must match setWebhook secret_token
WEBHOOK_SECRET=change-me-to-a-long-random-string

# Your Telegram numeric user id(s), comma-separated (privileged bootstrap)
BOOTSTRAP_PRIVILEGED_IDS=123456789

# upload (default: download media then re-upload) | url (pass remote URLs to Telegram)
MEDIA_MODE=upload

# Optional FxEmbed API base
# FX_TWITTER_API=https://api.fxtwitter.com
